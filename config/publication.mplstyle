## Saros publication figure style. GENERATED from config/figure_style.py;
## edit RC there and run `python -m config.figure_style`.
font.family: DejaVu Sans
font.size: 8.0
mathtext.fontset: dejavusans
mathtext.default: regular
axes.unicode_minus: True
axes.titlesize: 8.5
axes.titleweight: normal
axes.titlelocation: left
axes.labelsize: 8.0
xtick.labelsize: 8.0
ytick.labelsize: 8.0
legend.fontsize: 7.0
legend.title_fontsize: 7.0
text.color: 1F2328
axes.labelcolor: 1F2328
axes.edgecolor: 8A9099
xtick.color: 8A9099
ytick.color: 8A9099
xtick.labelcolor: 1F2328
ytick.labelcolor: 1F2328
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73'])
figure.facecolor: white
axes.facecolor: none
grid.color: E3E5E8
grid.linewidth: 0.6
grid.linestyle: -
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.axisbelow: True
axes.linewidth: 0.6
axes.labelpad: 3.5
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.minor.size: 1.8
ytick.minor.size: 1.8
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.5
ytick.minor.width: 0.5
xtick.major.pad: 2.5
ytick.major.pad: 2.5
lines.linewidth: 0.8
lines.markersize: 5.6
lines.markeredgewidth: 0.6
lines.solid_capstyle: projecting
lines.dash_capstyle: butt
patch.linewidth: 0.6
hatch.linewidth: 0.5
legend.frameon: False
legend.handlelength: 1.6
figure.dpi: 100
savefig.dpi: 600
savefig.format: pdf
savefig.bbox: standard
savefig.pad_inches: 0.0
savefig.facecolor: white
savefig.edgecolor: white
savefig.transparent: False
pdf.fonttype: 42
svg.fonttype: none
svg.hashsalt: saros-publication
